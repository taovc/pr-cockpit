{
  "name": "pr-cockpit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PR Cockpit — local AI PR workbench: multi-agent review in isolated git worktrees, human-gated GitHub comments",
  "author": "Weijie Tao",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:studio": "drizzle-kit studio",
    "typecheck": "nuxt typecheck",
    "eval": "tsx scripts/eval.ts",
    "codex:types": "node scripts/codex-generate-types.mjs",
    "test": "for f in tests/*.test.ts tests/*.contract.ts; do echo \"▸ $f\"; tsx \"$f\" || exit 1; done",
    "electron:dev": "concurrently -k -n nuxt,electron \"nuxt dev\" \"wait-on tcp:127.0.0.1:3000 && cross-env ELECTRON_RENDERER_URL=http://localhost:3000 electron .\"",
    "electron:build": "nuxt build && node scripts/prepare-electron-sqlite.mjs && node scripts/prepare-electron-codex.mjs && node scripts/write-build-info.mjs",
    "electron:preview": "pnpm electron:build && electron .",
    "electron:dist": "pnpm electron:build && electron-builder --publish=never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@nuxt/ui": "^4.11.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@openai/codex": "0.149.1",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.14",
    "drizzle-orm": "^0.45.2",
    "marked": "^18.0.11",
    "nanoid": "^6.0.1",
    "nuxt": "^4.5.2",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.126",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.11",
    "wait-on": "^9.1.0"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "appId": "com.prcockpit.app",
    "productName": "PR Cockpit",
    "artifactName": "${name}-${version}-${arch}.${ext}",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".output",
        "to": ".output"
      }
    ],
    "asar": true,
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": [
        "AppImage"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taovc/pr-cockpit.git"
  },
  "homepage": "https://github.com/taovc/pr-cockpit"
}
